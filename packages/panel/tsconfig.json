{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": [],
		"paths": {
			"@lib/*": ["../lib/*"],
			"@mytw/schema": ["../schema/index.ts"]
		}
	},
	"include": ["*.ts", "*.svelte"]
}
