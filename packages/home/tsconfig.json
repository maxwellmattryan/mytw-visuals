{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": [],
		"paths": {
			"@mytw/assets": ["../assets/index.ts"],
			"@mytw/document": ["../document/index.ts"],
			"@mytw/schema": ["../schema/index.ts"],
			"@mytw/storage": ["../storage/index.ts"]
		}
	},
	"include": ["*.ts", "*.svelte"]
}
