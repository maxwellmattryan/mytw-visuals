{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"include-component-in-tag": false,
	"bump-minor-pre-major": true,
	"bump-patch-for-minor-pre-major": false,
	"packages": {
		".": {
			"package-name": "mytw-visuals",
			"extra-files": [
				{ "type": "json", "path": "apps/sketchbook/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/assets/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/document/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/engine/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/fx/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/lib/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/panel/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/schema/package.json", "jsonpath": "$.version" },
				{ "type": "json", "path": "packages/sketch/package.json", "jsonpath": "$.version" }
			]
		}
	}
}
