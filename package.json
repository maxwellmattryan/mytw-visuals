{
	"name": "mytw-visuals",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "yarn workspace @mytw/sketchbook dev",
		"build": "tsc --noEmit && tsc -p packages/schema && tsc -p packages/engine && svelte-check --tsconfig ./packages/panel/tsconfig.json --fail-on-warnings && yarn workspace @mytw/sketchbook build",
		"preview": "yarn workspace @mytw/sketchbook preview",
		"new": "yarn workspace @mytw/sketchbook new",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "node --experimental-vm-modules ./node_modules/.bin/jest",
		"pre-commit": "lint-staged",
		"prepare": "yarn prepare:husky",
		"prepare:husky": "husky install",
		"convert": "./apps/sketchbook/scripts/convert.sh"
	},
	"devDependencies": {
		"@eslint/js": "9.20.0",
		"@types/node": "22.20.5",
		"eslint": "9.20.0",
		"eslint-config-prettier": "10.0.1",
		"eslint-plugin-prettier": "5.2.3",
		"globals": "15.15.0",
		"husky": "8.0.3",
		"jest": "29.7.0",
		"jiti": "2.7.0",
		"lint-staged": "16.2.7",
		"prettier": "3.5.2",
		"prettier-plugin-svelte": "3.5.2",
		"svelte-check": "4.7.8",
		"ts-jest": "29.4.15",
		"ts-node": "10.9.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	},
	"lint-staged": {
		"*.ts": "eslint --fix"
	}
}
