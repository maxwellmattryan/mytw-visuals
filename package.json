{
	"name": "mytw-visuals",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit && vite build",
		"preview": "vite preview",
		"new": "node scripts/new-sketch.ts",
		"lint": "eslint .",
		"format": "prettier --write .",
		"test": "node --experimental-vm-modules ./node_modules/.bin/jest",
		"pre-commit": "lint-staged",
		"prepare": "yarn prepare:husky",
		"prepare:husky": "husky install",
		"convert": "./scripts/convert.sh"
	},
	"dependencies": {
		"ccapture.js-npmfixed": "1.1.0",
		"p5": "1.11.3"
	},
	"devDependencies": {
		"@eslint/js": "9.20.0",
		"@types/node": "22.20.5",
		"@types/p5": "1.7.7",
		"eslint": "9.20.0",
		"eslint-config-prettier": "10.0.1",
		"eslint-plugin-prettier": "5.2.3",
		"glob": "11.0.1",
		"globals": "15.15.0",
		"husky": "8.0.3",
		"jest": "29.7.0",
		"jiti": "2.7.0",
		"lint-staged": "16.2.7",
		"prettier": "3.5.2",
		"ts-jest": "29.4.15",
		"ts-node": "10.9.2",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "6.1.0"
	},
	"lint-staged": {
		"*.ts": "eslint --fix"
	}
}
