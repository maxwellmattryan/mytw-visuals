{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"paths": {
			"@lib": ["./packages/lib/index.ts"],
			"@lib/*": ["./packages/lib/*"],
			"@mytw/assets": ["./packages/assets/index.ts"],
			"@mytw/schema": ["./packages/schema/index.ts"],
			"@mytw/document": ["./packages/document/index.ts"],
			"@mytw/fx": ["./packages/fx/index.ts"],
			"@mytw/panel": ["./packages/panel/index.ts"],
			"@mytw/engine": ["./packages/engine/index.ts"],
			"@mytw/scene": ["./packages/scene/index.ts"],
			"@mytw/sketch": ["./packages/sketch/index.ts"],
			"@mytw/export": ["./packages/export/index.ts"],
			"@mytw/layers": ["./packages/layers/index.ts"],
			"@mytw/storage": ["./packages/storage/index.ts"],
			"@mytw/home": ["./packages/home/index.ts"]
		}
	},
	"ts-node": {
		"compilerOptions": {
			"moduleResolution": "node10"
		}
	},
	"include": ["packages", "apps", "scripts", "*.ts"]
}
