{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"isolatedModules": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"types": ["node"],
		"paths": {
			"@lib": ["./packages/lib/index.ts"],
			"@lib/*": ["./packages/lib/*"],
			"@mytw/schema": ["./packages/schema/index.ts"]
		}
	},
	"ts-node": {
		"compilerOptions": {
			"moduleResolution": "node10"
		}
	},
	"include": ["packages", "apps", "scripts", "*.ts"]
}
